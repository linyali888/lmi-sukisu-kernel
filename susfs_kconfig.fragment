menu "KernelSU - SUSFS extras (kernel-side)"

config KSU_SUSFS_HAS_MAGIC_MOUNT
	bool "KernelSU has magic mount implemented"
	depends on KSU_SUSFS
	default y
	help
	  - Enable to indicate that the current SUSFS kernel supports the auto hide features for 5ec1cff's Magic Mount KernelSU
	  - Every mounts from /debug_ramdisk/workdir will be treated as magic mount and processed differently by susfs

config KSU_SUSFS_TRY_UMOUNT
	bool "Enable to use try umount for susfs"
	depends on KSU_SUSFS
	default y

config KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT
	bool "Enable to automatically add sus_mount for KSU default mount folder"
	depends on KSU_SUSFS_TRY_UMOUNT
	default y

config KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT
	bool "Enable to automatically add sus_mount for existing bind mounts with sus path"
	depends on KSU_SUSFS_TRY_UMOUNT
	default y

config KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT
	bool "Enable to automatically add try_umount for existing bind mounts mounted by KSU"
	depends on KSU_SUSFS_TRY_UMOUNT
	default y

config KSU_SUSFS_SUS_OVERLAYFS
	bool "Enable to automatically hide newly created overlayfs mounts"
	depends on KSU_SUSFS
	default y

endmenu
